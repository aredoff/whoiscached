; TCP WHOIS listener and connection limits
[server]
; Address for WHOIS wire protocol (TCP)
listen_addr = :4343
; Max time to read the query line from the client
read_timeout = 10s
; Max time to write the response to the client
write_timeout = 30s
; Reject new connections when this many are active
max_conns = 10000
; Concurrent request handlers (semaphore size)
worker_pool_size = 1024

; Prometheus HTTP endpoint
[metrics]
listen_addr = :8080

; Local snapshot file (atomic replace). Dirty RAM is flushed on interval or Close.
; CLI: -dump-keys, -get-key=KEY, -delete-key=KEY (same -config / WHOISCACHE_CONFIG).
[storage]
snapshot_path = /var/lib/whoiscache/whoiscache.snap
snapshot_interval = 1m

; TTLs for cache entries (Go duration syntax)
[cache]
; Successful domain lookups
domain_ttl = 1h
; Successful IP lookups
ip_ttl = 12d
; Successful ASN lookups
asn_ttl = 12d
; WHOIS negative / not-found style responses
negative_ttl = 1m
; Stale copy inside each Record: served on upstream error while stale TTL holds
stale_ttl = 30d

; Upstream WHOIS resolver behavior
[whois]
; Per-hop timeout when querying a WHOIS server
default_timeout = 15s
; Truncate responses larger than this (bytes)
max_response_bytes = 2097152
; Root server for domain/IP/ASN referral chains (host or host:port)
domain_root_server = whois.iana.org
; Resolver strategy for IP (only iana_referral is implemented)
ip_backend_strategy = iana_referral
; Resolver strategy for ASN (only iana_referral is implemented)
asn_backend_strategy = iana_referral
; Second hop for ASN if IANA path fails or returns negative
asn_fallback_server = whois.radb.net
; Max referral follows before giving up
max_referral_hops = 8
